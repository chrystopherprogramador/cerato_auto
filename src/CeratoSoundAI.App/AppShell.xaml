<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CeratoSoundAI.App.Views"
       x:Class="CeratoSoundAI.App.AppShell"
       BackgroundColor="{StaticResource Bg}" FlyoutBackgroundColor="{StaticResource Surface}"
       Shell.NavBarIsVisible="False" FlyoutWidth="230" FlyoutBehavior="Flyout">
  <Shell.ItemTemplate>
    <DataTemplate>
      <Grid HeightRequest="64" Padding="20,0">
        <Label Text="{Binding Title}" VerticalOptions="Center" FontSize="19" TextColor="{StaticResource TextPrimary}" />
      </Grid>
    </DataTemplate>
  </Shell.ItemTemplate>
  <Shell.FlyoutHeader>
    <VerticalStackLayout Padding="20,28,20,16" BackgroundColor="{StaticResource Surface}">
      <Label Text="CERATO" FontSize="22" FontAttributes="Bold" CharacterSpacing="4" TextColor="{StaticResource Accent}" />
      <Label Text="SOUND AI" FontSize="22" FontAttributes="Bold" CharacterSpacing="4" />
    </VerticalStackLayout>
  </Shell.FlyoutHeader>
  <ShellContent Title="Início" ContentTemplate="{DataTemplate views:MainPage}" Route="main" />
  <ShellContent Title="Equalizador" ContentTemplate="{DataTemplate views:EqualizerPage}" Route="eq" />
  <ShellContent Title="Assistente IA" ContentTemplate="{DataTemplate views:AssistantPage}" Route="assistant" />
  <ShellContent Title="Perfis" ContentTemplate="{DataTemplate views:ProfilesPage}" Route="profiles" />
  <ShellContent Title="Calibração" ContentTemplate="{DataTemplate views:CalibrationPage}" Route="calibration" />
  <ShellContent Title="Diagnóstico" ContentTemplate="{DataTemplate views:DiagnosticsPage}" Route="diagnostics" />
  <ShellContent Title="Histórico" ContentTemplate="{DataTemplate views:HistoryPage}" Route="history" />
  <ShellContent Title="Configurações" ContentTemplate="{DataTemplate views:SettingsPage}" Route="settings" />
</Shell>
